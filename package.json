{
  "name": "parmarpro",
  "version": "0.1.0",
  "private": true,
  "description": "ParmarPro: patient-recovery and operations platform for dental clinics",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "check:secrets-guard": "node scripts/check-public-env.mjs",
    "db:local:start": "bash scripts/local-db/start.sh",
    "db:local:stop": "bash scripts/local-db/stop.sh",
    "db:types": "node scripts/gen-db-types.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.22",
    "@hookform/resolvers": "6.0.2",
    "@sentry/nextjs": "11.9.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "posthog-js": "1.441.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.52",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
