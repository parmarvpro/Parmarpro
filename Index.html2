                            <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-brand-orange/20 flex items-center justify-center border border-brand-orange">
                                <svg class="w-3 h-3 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold uppercase tracking-wider text-sm mb-1">We Manage Flow</h4>
