```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flying Movements Foundation | Empowering Mumbai</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- GSAP for Premium Scroll Animations (Flomio Studio Style) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    
    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        oswald: ['Oswald', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            dark: '#050505',
                            charcoal: '#121212',
                            gray: '#242424',
                            light: '#e5e5e5',
                            orange: '#ff5500', // Strong flame orange
                            orangeHover: '#e64d00'
                        }
                    },
                    backgroundImage: {
                        'gradient-radial': 'radial-gradient(var(--tw-gradient-stops))',
                    }
                }
            }
        }
    </script>

    <!-- Custom CSS for specialized effects -->
    <style>
        body {
            background-color: #050505;
            color: #e5e5e5;
            overflow-x: hidden;
        }

        /* Noise Texture Overlay */
        .noise-bg {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            pointer-events: none;
            z-index: 50;
            opacity: 0.03;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Typography Utilities */
        .text-outline {
            color: transparent;
            -webkit-text-stroke: 1px rgba(255, 255, 255, 0.8);
        }
        @media (min-width: 768px) {
            .text-outline { -webkit-text-stroke: 2px rgba(255, 255, 255, 0.8); }
        }

        /* Form Styling */
        .input-editorial {
            background: transparent;
            border: none;
            border-bottom: 1px solid #333;
            border-radius: 0;
            padding: 1rem 0;
            color: white;
            transition: border-color 0.3s ease;
        }
        .input-editorial:focus {
            outline: none;
            border-bottom: 1px solid #ff5500;
            box-shadow: none;
        }
        .input-editorial::placeholder {
            color: #666;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
        }

        /* Scroll Reveal Animations */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #ff5500; }
    </style>
</head>
<body class="antialiased selection:bg-brand-orange selection:text-white">

    <div class="noise-bg"></div>

    <!-- 1. TOP NAVIGATION -->
    <nav class="fixed w-full z-40 top-0 border-b border-white/10 bg-brand-dark/80 backdrop-blur-md transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <a href="#" class="flex items-center group">
                    <span class="font-oswald uppercase tracking-widest text-3xl font-bold text-white transition-colors duration-300 group-hover:text-brand-orange">FMF</span>
                </a>

                <!-- Desktop Nav -->
                <div class="hidden md:flex items-center space-x-10">
                    <a href="#services" class="text-sm uppercase tracking-widest text-gray-400 hover:text-white hover:border-b hover:border-brand-orange pb-1 transition-all">Services</a>
                    <a href="#camp-services" class="text-sm uppercase tracking-widest text-gray-400 hover:text-white hover:border-b hover:border-brand-orange pb-1 transition-all">Camps</a>
                    <a href="#societies" class="text-sm uppercase tracking-widest text-gray-400 hover:text-white hover:border-b hover:border-brand-orange pb-1 transition-all">Societies</a>
                    <a href="#leadership" class="text-sm uppercase tracking-widest text-gray-400 hover:text-white hover:border-b hover:border-brand-orange pb-1 transition-all">About Us</a>
                </div>

                <!-- CTA -->
                <div class="hidden md:block">
                    <a href="#contact" class="px-6 py-3 border border-brand-orange text-brand-orange text-sm uppercase tracking-widest font-semibold hover:bg-brand-orange hover:text-white transition-colors duration-300">
                        Get Support
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button class="md:hidden text-white focus:outline-none" id="mobile-menu-btn">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
        
        <!-- Mobile Nav Menu -->
        <div class="md:hidden hidden bg-brand-charcoal border-b border-white/10" id="mobile-menu">
            <div class="px-6 pt-4 pb-6 space-y-4 flex flex-col">
                <a href="#services" class="text-lg uppercase tracking-widest text-white border-b border-white/5 pb-2">Services</a>
                <a href="#camp-services" class="text-lg uppercase tracking-widest text-white border-b border-white/5 pb-2">Camps</a>
                <a href="#societies" class="text-lg uppercase tracking-widest text-white border-b border-white/5 pb-2">Societies</a>
                <a href="#leadership" class="text-lg uppercase tracking-widest text-white border-b border-white/5 pb-2">About Us</a>
                <a href="#contact" class="text-brand-orange uppercase tracking-widest font-bold pt-2">Get Support &rarr;</a>
            </div>
        </div>
    </nav>

    <!-- 2. HERO SECTION -->
    <section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="absolute top-1/2 left-1/4 -translate-y-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-brand-orange/10 rounded-full blur-[120px]"></div>
            <div class="absolute right-0 top-0 w-1/2 h-full opacity-20" style="background-image: radial-gradient(#333 1px, transparent 1px); background-size: 40px 40px;"></div>
        </div>

        <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 w-full grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-8 reveal">
                <p class="text-brand-orange uppercase tracking-[0.2em] font-semibold text-sm mb-6 pl-1 flex items-center gap-4">
                    <span class="w-8 h-[1px] bg-brand-orange"></span> Organized Civic Action
                </p>
                
                <h1 class="font-oswald text-[12vw] lg:text-[9rem] leading-[0.85] uppercase mb-8">
                    <span class="block text-white">Flying</span>
                    <span class="block text-brand-orange">Movements</span>
                    <span class="block text-outline mt-2">Foundation</span>
                </h1>
                
                <p class="text-gray-400 text-lg md:text-xl max-w-2xl font-light leading-relaxed mb-10 pl-1 border-l-2 border-brand-orange/30 ml-1 pl-6">
                    Direct support for middle-class societies and citizens. <br class="hidden md:block">
                    We simplify government scheme access through organized camps, precise documentation guidance, and relentless follow-up support.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 pl-1">
                    <a href="#contact" class="bg-brand-orange text-white px-8 py-4 uppercase tracking-widest text-sm font-bold hover:bg-brand-orangeHover transition-colors flex items-center justify-center gap-3 group">
                        Book Free Camp
                        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                    <a href="#contact" class="border border-white/20 text-white px-8 py-4 uppercase tracking-widest text-sm font-bold hover:border-white hover:bg-white/5 transition-colors flex items-center justify-center gap-3">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.098.824z"></path></svg>
                        WhatsApp Us
                    </a>
                </div>
            </div>

            <div class="hidden lg:block lg:col-span-4 reveal delay-200">
                <div class="relative w-full aspect-[3/4] border border-white/10 p-4">
                    <div class="w-full h-full border border-brand-orange/30 relative flex flex-col justify-end p-6 overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-t from-brand-orange/20 to-transparent"></div>
                        <div class="w-full h-[1px] bg-brand-orange/50 mb-8 absolute top-1/4 left-0"></div>
                        <div class="w-[1px] h-full bg-brand-orange/50 absolute left-1/3 top-0"></div>
                        
                        <div class="relative z-10 text-right">
                            <span class="block font-oswald text-4xl text-white opacity-20 uppercase">Mumbai</span>
                            <span class="block font-oswald text-6xl text-white opacity-40 uppercase -mt-2">HQ</span>
                        </div>
                    </div>
                    <div class="absolute top-0 left-0 w-2 h-2 bg-brand-orange"></div>
                    <div class="absolute bottom-0 right-0 w-2 h-2 bg-brand-orange"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. STATISTICS STRIP -->
    <section class="border-y border-brand-orange/20 bg-brand-charcoal py-12 relative z-20">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 divide-x-0 md:divide-x divide-white/10 text-center">
                <div class="reveal">
                    <p class="font-oswald text-5xl lg:text-6xl text-brand-orange mb-2">450<span class="text-white">+</span></p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400">Societies Reached</p>
                </div>
                <div class="reveal delay-100">
                    <p class="font-oswald text-5xl lg:text-6xl text-brand-orange mb-2">12K<span class="text-white">+</span></p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400">Cards Issued</p>
                </div>
                <div class="reveal delay-200">
                    <p class="font-oswald text-5xl lg:text-6xl text-brand-orange mb-2">24/7</p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400">Field Support</p>
                </div>
                <div class="reveal delay-300">
                    <p class="font-oswald text-5xl lg:text-6xl text-brand-orange mb-2">0<span class="text-white">%</span></p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400">Bureaucracy Friction</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. CORE SERVICES & MEDICAL CAMPS (Static part) -->
    <section id="services" class="py-24 lg:py-32 bg-brand-dark">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            
            <div class="mb-16 md:mb-24 reveal">
                <h2 class="font-oswald text-5xl md:text-7xl uppercase text-white mb-4">Core <span class="text-brand-orange">Initiatives</span></h2>
                <p class="text-gray-400 text-lg uppercase tracking-widest">End-to-end society and health welfare</p>
            </div>

            <!-- Full-Width Medical Camp Card -->
            <div class="group bg-brand-charcoal border border-white/5 hover:border-brand-orange/50 transition-colors duration-500 reveal relative overflow-hidden p-8 lg:p-12">
                <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
                    <svg class="w-48 h-48 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="1" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                </div>
                
                <div class="relative z-10 flex flex-col md:flex-row md:items-start md:justify-between gap-10">
                    <div class="md:w-1/3">
                        <div class="text-brand-orange mb-6">
                            <span class="text-sm font-oswald uppercase tracking-widest border border-brand-orange px-3 py-1">Health Initiative</span>
                        </div>
                        <h3 class="font-oswald text-4xl uppercase text-white mb-4">Free Medical <br>Check-up Camps</h3>
                        <p class="text-gray-400 font-light leading-relaxed">
                            Comprehensive diagnostic and preventative healthcare camps organized directly within your society premises. We bring the essential medical infrastructure to your doorstep.
                        </p>
                    </div>
                    
                    <div class="md:w-2/3 lg:pl-12 md:border-l md:border-white/10">
                        <p class="text-sm uppercase tracking-widest text-brand-orange mb-6 font-bold">Camp Inclusions</p>
                        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-4 gap-x-6">
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">Blood Pressure</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">Blood Sugar</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">BMI Test</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">Eye Check Up</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">Doctor's Consultation</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">Bone Density Test</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                                <span class="text-gray-300 uppercase tracking-wide text-sm font-medium">Breathing Test</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4.5 FLOMIO-STYLE HORIZONTAL SCROLL FOR CAMP SERVICES -->
    <!-- This section pins during scroll and slides the cards horizontally -->
    <section id="camp-services" class="bg-brand-charcoal border-y border-white/5 relative z-20">
        <div id="horizontal-wrapper" class="h-[100vh] w-full overflow-hidden bg-brand-charcoal relative">
            
            <!-- Fixed Left Panel (Overlays the track) -->
            <div class="absolute top-0 left-0 w-full md:w-[35vw] h-[35vh] md:h-full px-6 lg:px-12 flex flex-col justify-end md:justify-center pb-8 md:pb-0 border-b md:border-b-0 md:border-r border-white/5 bg-brand-charcoal z-20 shadow-[10px_0_30px_rgba(0,0,0,0.5)] md:shadow-none">
                <div class="text-brand-orange mb-4 md:mb-6">
                    <span class="text-xs md:text-sm font-oswald uppercase tracking-widest border border-brand-orange px-3 py-1">Society Expertise</span>
                </div>
                <h2 class="font-oswald text-4xl md:text-6xl uppercase leading-tight text-white mb-4 md:mb-6">
                    Services <br class="hidden md:block">Provided <br><span class="text-brand-orange">Via Camps</span>
                </h2>
                <div class="hidden md:flex items-center gap-4 text-brand-orange opacity-50 uppercase tracking-widest text-xs font-bold">
                    <span>Scroll to explore</span>
                    <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </div>
            </div>

            <!-- Horizontally Scrolling Track -->
            <div class="h-full flex items-end md:items-center absolute top-0 left-0 z-10 w-max" id="horizontal-track">
                
                <!-- Spacer to push cards past the static left panel on desktop -->
                <div class="w-0 md:w-[35vw] h-full flex-shrink-0 pointer-events-none"></div>

                <!-- Cards Container -->
                <div class="flex flex-row gap-6 md:gap-10 px-6 md:px-10 pb-[10vh] md:pb-0 pt-[35vh] md:pt-0 items-center h-full">
                    
                    <!-- Square Block 1 -->
                    <div class="w-[75vw] md:w-[40vw] lg:w-[32vw] aspect-square bg-brand-dark border border-white/10 p-8 flex flex-col justify-between group hover:border-brand-orange transition-colors duration-500 relative flex-shrink-0 overflow-hidden cursor-default">
                        <div class="absolute left-8 top-1/2 w-[150%] h-[1px] bg-white/5 -translate-y-1/2 group-hover:bg-brand-orange/20 transition-colors transform -rotate-45 origin-left"></div>
                        <div class="text-brand-orange font-oswald text-6xl md:text-7xl opacity-40 group-hover:opacity-100 transition-opacity">01</div>
                        <div class="relative z-10 border-l-2 border-brand-orange pl-6">
                            <h3 class="font-oswald text-3xl md:text-4xl lg:text-5xl text-white uppercase leading-tight">Ayushman <br>Bharat <br>Yojna</h3>
                        </div>
                    </div>

                    <!-- Square Block 2 -->
                    <div class="w-[75vw] md:w-[40vw] lg:w-[32vw] aspect-square bg-brand-dark border border-white/10 p-8 flex flex-col justify-between group hover:border-brand-orange transition-colors duration-500 relative flex-shrink-0 overflow-hidden cursor-default">
                        <div class="absolute left-8 top-1/2 w-[150%] h-[1px] bg-white/5 -translate-y-1/2 group-hover:bg-brand-orange/20 transition-colors transform -rotate-45 origin-left"></div>
                        <div class="text-brand-orange font-oswald text-6xl md:text-7xl opacity-40 group-hover:opacity-100 transition-opacity">02</div>
                        <div class="relative z-10 border-l-2 border-brand-orange pl-6">
                            <h3 class="font-oswald text-3xl md:text-4xl lg:text-5xl text-white uppercase leading-tight">Vay <br>Vandana <br>Yojna</h3>
                        </div>
                    </div>

                    <!-- Square Block 3 -->
                    <div class="w-[75vw] md:w-[40vw] lg:w-[32vw] aspect-square bg-brand-dark border border-white/10 p-8 flex flex-col justify-between group hover:border-brand-orange transition-colors duration-500 relative flex-shrink-0 overflow-hidden cursor-default">
                        <div class="absolute left-8 top-1/2 w-[150%] h-[1px] bg-white/5 -translate-y-1/2 group-hover:bg-brand-orange/20 transition-colors transform -rotate-45 origin-left"></div>
                        <div class="text-brand-orange font-oswald text-6xl md:text-7xl opacity-40 group-hover:opacity-100 transition-opacity">03</div>
                        <div class="relative z-10 border-l-2 border-brand-orange pl-6">
                            <h3 class="font-oswald text-3xl md:text-4xl lg:text-5xl text-white uppercase leading-tight">Senior <br>Citizen <br>Card</h3>
                        </div>
                    </div>

                    <!-- Square Block 4 -->
                    <div class="w-[75vw] md:w-[40vw] lg:w-[32vw] aspect-square bg-brand-dark border border-white/10 p-8 flex flex-col justify-between group hover:border-brand-orange transition-colors duration-500 relative flex-shrink-0 overflow-hidden cursor-default">
                        <div class="absolute left-8 top-1/2 w-[150%] h-[1px] bg-white/5 -translate-y-1/2 group-hover:bg-brand-orange/20 transition-colors transform -rotate-45 origin-left"></div>
                        <div class="text-brand-orange font-oswald text-6xl md:text-7xl opacity-40 group-hover:opacity-100 transition-opacity">04</div>
                        <div class="relative z-10 border-l-2 border-brand-orange pl-6">
                            <h3 class="font-oswald text-3xl md:text-4xl lg:text-5xl text-white uppercase leading-tight">Voter <br>Id</h3>
                        </div>
                    </div>

                    <!-- Square Block 5 -->
                    <div class="w-[75vw] md:w-[40vw] lg:w-[32vw] aspect-square bg-brand-dark border border-white/10 p-8 flex flex-col justify-between group hover:border-brand-orange transition-colors duration-500 relative flex-shrink-0 overflow-hidden cursor-default">
                        <div class="absolute left-8 top-1/2 w-[150%] h-[1px] bg-white/5 -translate-y-1/2 group-hover:bg-brand-orange/20 transition-colors transform -rotate-45 origin-left"></div>
                        <div class="text-brand-orange font-oswald text-6xl md:text-7xl opacity-40 group-hover:opacity-100 transition-opacity">05</div>
                        <div class="relative z-10 border-l-2 border-brand-orange pl-6">
                            <h3 class="font-oswald text-3xl md:text-4xl lg:text-5xl text-white uppercase leading-tight">Senior Citizen <br>Pension Yojna <br>Guidance.</h3>
                        </div>
                    </div>

                    <!-- Square Block 6 -->
                    <div class="w-[75vw] md:w-[40vw] lg:w-[32vw] aspect-square bg-brand-dark border border-white/10 p-8 flex flex-col justify-between group hover:border-brand-orange transition-colors duration-500 relative flex-shrink-0 overflow-hidden cursor-default pr-12">
                        <div class="absolute left-8 top-1/2 w-[150%] h-[1px] bg-white/5 -translate-y-1/2 group-hover:bg-brand-orange/20 transition-colors transform -rotate-45 origin-left"></div>
                        <div class="text-brand-orange font-oswald text-6xl md:text-7xl opacity-40 group-hover:opacity-100 transition-opacity">06</div>
                        <div class="relative z-10 border-l-2 border-brand-orange pl-6">
                            <h3 class="font-oswald text-3xl md:text-4xl lg:text-5xl text-white uppercase leading-tight">Widow <br>Pension Yojna <br>Guidance</h3>
