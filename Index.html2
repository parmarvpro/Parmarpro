        </div>
    </section>

    <!-- 7. LEADERSHIP -->
    <section id="leadership" class="py-24 bg-brand-dark">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="mb-16 md:mb-20 text-center reveal">
