                <div class="group border border-white/10 bg-brand-charcoal p-8 relative overflow-hidden reveal">
                    <div class="absolute inset-0 bg-brand-orange/5 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-700"></div>
                    <div class="relative z-10 flex flex-col items-center text-center">
