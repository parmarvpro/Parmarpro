    <!-- 8. CONTACT / REQUEST CAMP FORM -->
    <section id="contact" class="py-24 lg:py-32 bg-brand-dark border-t border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="grid lg:grid-cols-5 gap-16">
                <!-- Info Side -->
                <div class="lg:col-span-2 reveal">
                    <h2 class="font-oswald text-5xl uppercase mb-8">Connect with <br><span class="text-brand-orange">The Foundation</span></h2>
                    <p class="text-gray-400 mb-12 font-light">
                        Request a camp for your housing society, seek citizen support, or inquire about hospital partnerships. Our ground team responds within 24 hours.
                    </p>
                    <div class="space-y-8">
                        <div>
                            <p class="text-xs uppercase tracking-widest text-brand-orange mb-2 font-bold">Headquarters</p>
                            <p class="text-white font-light">Mumbai, Maharashtra<br>Operating across MMR region.</p>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-widest text-brand-orange mb-2 font-bold">Direct Line</p>
                            <p class="text-white font-light">+91 97694 12521<br>WhatsApp Support Available</p>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-widest text-brand-orange mb-2 font-bold">Digital</p>
                            <p class="text-white font-light">CEO@flyingmovementfoundation.in</p>
                        </div>
                    </div>
                </div>

                <!-- Form Side -->
                <div class="lg:col-span-3 reveal delay-200">
                    <div class="border border-white/10 p-8 md:p-12 bg-brand-charcoal">
                        <form action="#" method="POST" class="space-y-8">
                            <div class="grid md:grid-cols-2 gap-8">
                                <div>
                                    <label class="sr-only">Full Name</label>
                                    <input type="text" placeholder="Full Name" required class="input-editorial w-full">
                                </div>
                                <div>
                                    <label class="sr-only">Phone Number</label>
                                    <input type="tel" placeholder="Phone Number (WhatsApp)" required class="input-editorial w-full">
                                </div>
                            </div>
                            <div class="grid md:grid-cols-2 gap-8">
                                <div>
                                    <label class="sr-only">Society Name</label>
                                    <input type="text" placeholder="Society Name" required class="input-editorial w-full">
                                </div>
                                <div>
                                    <label class="sr-only">Area / Locality</label>
                                    <input type="text" placeholder="Area / Locality (e.g., Andheri West)" required class="input-editorial w-full">
                                </div>
                            </div>
                            <div>
                                <label class="sr-only">Request Type</label>
                                <select class="input-editorial w-full appearance-none cursor-pointer" required style="color: #666; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.1em;">
                                    <option value="" disabled selected>Select Request Type</option>
                                    <option value="society_camp">Book Society Camp</option>
                                    <option value="medical_camp">Book Medical Check-up Camp</option>
                                    <option value="citizen_support">Individual Citizen Support</option>
                                    <option value="hospital">Hospital Partnership</option>
                                    <option value="other">Other Inquiry</option>
                                </select>
                            </div>
                            <div>
                                <label class="sr-only">Message</label>
                                <textarea rows="3" placeholder="Message or specific requirements" class="input-editorial w-full resize-none"></textarea>
                            </div>
                            <button type="submit" class="w-full bg-brand-orange text-white py-5 uppercase tracking-widest text-sm font-bold hover:bg-brand-orangeHover transition-colors mt-4">
                                Submit Request
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 9. FOOTER -->
    <footer class="bg-brand-dark border-t border-white/10 pt-16 pb-8 text-center md:text-left">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="grid md:grid-cols-3 gap-8 items-center mb-12">
                <div>
                    <span class="font-oswald uppercase tracking-widest text-xl font-bold text-white block mb-2">Flying Movements Foundation</span>
                    <span class="text-gray-500 text-sm">Empowering Mumbai. Organizing access.</span>
                </div>
                <div class="flex justify-center gap-6">
                    <a href="#" class="text-gray-500 hover:text-brand-orange transition-colors text-sm uppercase tracking-widest">Privacy</a>
                    <a href="#" class="text-gray-500 hover:text-brand-orange transition-colors text-sm uppercase tracking-widest">Terms</a>
                    <a href="#contact" class="text-gray-500 hover:text-brand-orange transition-colors text-sm uppercase tracking-widest">Contact</a>
                </div>
                <div class="flex justify-center md:justify-end gap-4">
                    <a href="#" class="w-10 h-10 border border-white/10 rounded-full flex items-center justify-center text-gray-500 hover:text-white hover:border-brand-orange transition-all">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                </div>
            </div>
            <div class="border-t border-white/5 pt-8 text-center">
                <p class="text-xs text-gray-600 uppercase tracking-widest">&copy; <span id="year"></span> Flying Movements Foundation. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- JavaScript for Interactions -->
    <script>
        // Set current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile Menu Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const navbar = document.getElementById('navbar');

        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Navbar blur effect on scroll
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('shadow-lg', 'bg-brand-dark/95');
                navbar.classList.remove('bg-brand-dark/80');
            } else {
                navbar.classList.remove('shadow-lg', 'bg-brand-dark/95');
                navbar.classList.add('bg-brand-dark/80');
            }
        });

        // Basic Intersection Observer for standard reveals
        const revealElements = document.querySelectorAll('.reveal');
        const revealOptions = {
            threshold: 0.15,
            rootMargin: "0px 0px -50px 0px"
        };
        const revealOnScroll = new IntersectionObserver(function(entries, observer) {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('active');
                observer.unobserve(entry.target);
            });
        }, revealOptions);

        revealElements.forEach(el => revealOnScroll.observe(el));

        // --- GSAP HORIZONTAL SCROLL ANIMATION (FLOMIO STYLE) ---
        gsap.registerPlugin(ScrollTrigger);

        const horizontalTrack = document.getElementById('horizontal-track');
        const horizontalWrapper = document.getElementById('horizontal-wrapper');
        
        function getScrollAmount() {
            let trackWidth = horizontalTrack.scrollWidth;
            let viewportWidth = window.innerWidth;
            // The exact distance the track needs to slide to show the last card
            return trackWidth - viewportWidth;
        }

        const tween = gsap.to(horizontalTrack, {
            x: () => -getScrollAmount(),
            ease: "none"
        });

        ScrollTrigger.create({
            trigger: horizontalWrapper,
            start: "top top",
            end: () => `+=${getScrollAmount()}`, 
            pin: true,
            animation: tween,
            scrub: 1,
            invalidateOnRefresh: true 
        });
    </script>
</body>
</html>


```
