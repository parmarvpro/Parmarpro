    </section>

    <!-- 5. SOCIETY PARTNERSHIP / INFRASTRUCTURE -->
    <section id="societies" class="py-24 lg:py-32 bg-brand-charcoal overflow-hidden border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <!-- Left: Visual -->
                <div class="relative reveal">
                    <div class="aspect-square md:aspect-[4/3] bg-brand-dark border border-white/10 relative p-8 flex items-end">
                        <div class="absolute inset-0 opacity-30" style="background-image: linear-gradient(#333 1px, transparent 1px), linear-gradient(90deg, #333 1px, transparent 1px); background-size: 20px 20px;"></div>
                        <div class="relative z-10 flex items-end gap-4 w-full h-full opacity-80">
                            <div class="w-1/3 bg-white/5 h-3/4 border-t border-r border-white/20"></div>
