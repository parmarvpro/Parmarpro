# ParmarPro environment variables. Placeholders only: never commit real values.
# See docs/environment-variables.md for scope (Development / Preview / Production).
# Anything prefixed NEXT_PUBLIC_ is visible to every browser. Never put a secret there.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development            # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (authentication, organizations) ----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me                     # server only
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me           # server only
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (database) -----------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me      # server only by choice (not needed in the browser)
SUPABASE_SECRET_KEY=sb_secret_replace_me                # server only, PRIVILEGED (bypasses RLS)

# --- Sentry (errors) ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=                                  # public by design; leave empty to disable
SENTRY_ORG=parmarpro                                     # build only
SENTRY_PROJECT=parmarpro-web                             # build only
SENTRY_AUTH_TOKEN=                                       # build only (source maps), secret

# --- PostHog (product analytics) --------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=                                 # project API key (public by design); empty disables analytics
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Email and automations (Resend, scheduled jobs) -------------------------
RESEND_API_KEY=                                          # server only; create at https://resend.com/api-keys
EMAIL_FROM=                                              # server only; "ParmarPro <hello@your-domain>" on a domain verified in Resend
FOUNDER_ALERT_EMAIL=                                     # server only; receives enquiry alerts and the daily digest
CRON_SECRET=                                             # server only; `openssl rand -hex 32`; authenticates scheduled job calls
LINK_SIGNING_SECRET=                                     # server only; `openssl rand -hex 32`; signs email action and opt-out links

# --- AI (Gemini; each lane is off until its key is set) ---------------------
GEMINI_FREE_API_KEY=                                     # server only; key from a Google Cloud project WITHOUT billing; receives only our own non-personal data
GEMINI_PAID_API_KEY=                                     # server only; key from a SEPARATE Google Cloud project WITH billing
