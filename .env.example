# ParmarPro environment variables. Placeholders only: never commit real values.
# See docs/environment-variables.md for scope (Development / Preview / Production).
# Anything prefixed NEXT_PUBLIC_ is visible to every browser. Never put a secret there.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development            # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (authentication, organizations) ----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me                     # server only
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me           # server only
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (database) -----------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me      # server only by choice (not needed in the browser)
SUPABASE_SECRET_KEY=sb_secret_replace_me                # server only, PRIVILEGED (bypasses RLS)

# --- Razorpay (payments) ------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_me                     # server only (sent to the browser per order)
RAZORPAY_KEY_SECRET=replace_me                          # server only
RAZORPAY_WEBHOOK_SECRET=replace_me                      # server only

# --- Sentry (errors) ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=                                  # public by design; leave empty to disable
SENTRY_ORG=parmarpro                                     # build only
SENTRY_PROJECT=parmarpro-web                             # build only
SENTRY_AUTH_TOKEN=                                       # build only (source maps), secret

# --- PostHog (product analytics) --------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=                                 # project API key (public by design); empty disables analytics
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
